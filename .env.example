# 📝 HOSTILERZ - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# ── SERVER CONFIG ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── DATABASE CONFIG (Cloud / Railway) ─────────────────────────────────────────
# Option A: Connection String (Recommended for Railway/Render/DigitalOcean)
# DATABASE_URL=mysql://user:pass@host:port/dbname
# MYSQL_URL=mysql://user:pass@host:port/dbname

# Option B: Individual Variables (Fallback)
DB_NAME=hostilerz_db
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306

# 🔍 SSL Config (Set to true for cloud databases like Railway)
DB_SSL=false

# 🛡️ Production Safety
# Set to true in production once your schema is stabilized to prevent auto-syncs.
SKIP_DB_SYNC=false

# ── SERVICES ──────────────────────────────────────────────────────────────────
# Gmail credentials for Gate Pass notifications
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# JWT Secret for session persistence
JWT_SECRET=your_super_secret_key_change_this
